{
  "name": "sprout-canvas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node server.mjs",
    "test": "node --check server.mjs && node --check server/queue.mjs && node --check server/text-routing.mjs && node tests/queue-routing.test.mjs && node tests/text-routing.test.mjs && npm run build && npm run test:legacy",
    "test:legacy": "node --check js/app.js",
    "start:prod": "NODE_ENV=production node server.mjs",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:logs": "pm2 logs sprout-canvas"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3"
  }
}
