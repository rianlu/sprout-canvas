      "baseUrl": "https://api.openai.com",
      "apiKey": "sk-your-backup-text-api-key",
      "model": "gpt-5-mini"
    }
  ],
  "imageConcurrency": 1,
  "stateFile": "data/runtime.sqlite",
  "host": "127.0.0.1",
  "port": 8787,
  "accessPassword": "change-this-password",
  "authSessionDays": 7,
  "secureCookies": false,
  "logFile": "logs/server.log"
