{
  "defaultImageProvider": "default",
  "imageProviders": [
    {
      "id": "default",
      "name": "芽绘一号",
      "baseUrl": "https://api.openai.com",
      "apiKey": "sk-your-default-api-key",
      "imageModel": "gpt-image-2",
      "generationMode": "images",
      "capabilities": {
        "outputFormats": ["png", "jpeg", "webp"],
        "exactSize": false
      }
    },
    {
      "id": "backup",
      "name": "芽绘二号",
      "baseUrl": "https://a-ocnfniawgw.cn-shanghai.fcapp.run",
      "apiKey": "sk-your-backup-api-key",
      "imageModel": "gpt-5.3-codex",
      "generationMode": "responses",
      "requestHeaders": {
        "chatgpt-account-id": "",
        "version": "0.122.0",
        "originator": "codex_cli_rs",
        "session_id": "{{sessionId}}"
      }
    }
  ],
  "textProviders": [
    {
      "id": "text",
      "name": "文本服务商",
      "baseUrl": "https://api.openai.com",
      "apiKey": "sk-your-text-api-key",
